# Copie para .env (que nunca vai para o Git) e preencha. Lido por `npm run dev:full`.
# Chaves cadastradas por conta em Configurações têm prioridade sobre as do servidor.

# --- Escrita dos agentes: qualquer endpoint compatível com chat completions ---
# OpenRouter: crie a chave em https://openrouter.ai/keys
MEMORABLE_AI_URL=https://openrouter.ai/api/v1/chat/completions
MEMORABLE_AI_KEY=
# Modelos sugeridos: anthropic/claude-opus-5.5 (melhor qualidade), anthropic/claude-sonnet-5.5 (mais barato)
MEMORABLE_AI_MODEL=anthropic/claude-opus-5.5

# --- Alternativa: Claude direto na Anthropic (tem prioridade sobre MEMORABLE_AI_* se preenchida) ---
ANTHROPIC_API_KEY=
# MEMORABLE_CLAUDE_MODEL=claude-opus-5-5

# --- Higgsfield pela API da plataforma (https://cloud.higgsfield.ai → API keys) ---
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Também aceita o par completo "ID:SECRET" colado só em HF_API_KEY_SECRET.

# Modelos por função (OpenRouter). A conta pode trocar em Configurações > Modelos por função.
# O juiz cego deve ser de outra família que o redator.
MEMORABLE_MODEL_WRITER=anthropic/claude-opus-5.5
MEMORABLE_MODEL_REVIEWER=google/gemini-4-argon
MEMORABLE_MODEL_JUDGE=openai/gpt-6.1-sol

# --- Nuvem (domínio memoravel.org na Cloudflare, banco no Supabase) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Somente no servidor; nunca com prefixo público (NEXT_PUBLIC_/VITE_).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Implantação (Render). Localmente deixe em branco. ---
# Endereço público do app; liga o cookie seguro e a origem permitida.
MEMORAVEL_PUBLIC_URL=
# 32 bytes em hex que criptografam as credenciais salvas. Na nuvem substitui .runtime/credentials.key.
MEMORAVEL_CREDENTIALS_KEY=
